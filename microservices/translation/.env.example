# Translation model tier. deploy.py picks this automatically based on detected hardware
# unless you set it here yourself.
#   CPU:  ai4bharat/indictrans2-indic-en-dist-200M
#   GPU:  ai4bharat/indictrans2-indic-en-1B  (noticeably more accurate on legal/administrative
#         register, but wants a GPU to run at acceptable speed)
INDICTRANS_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
