# Generation model. `deploy.py up` picks this from detected hardware and writes it here,
# unless you set it to something other than the placeholder below, in which case it is left
# alone. `deploy.py tier` reports the decision without changing anything.
#
# The value is an Ollama tag (qwen3:8b) or a HuggingFace repo id (Qwen/Qwen3-8B) depending
# on which engine the hardware selects:
#
#   engine       hardware                                    model
#   ----------   -----------------------------------------   -----------------
#   sglang       CUDA GPU, compute capability >= 7.5          Qwen/Qwen3-32B    >= 70GB VRAM
#                and docker nvidia runtime present            Qwen/Qwen3-14B    >= 36GB
#                                                             Qwen/Qwen3-8B     >= 20GB
#                                                             Qwen/Qwen3-4B     >= 12GB
#                                                             Qwen/Qwen3-1.7B   >= 8GB
#   ollama+gpu   CUDA GPU older than 7.5 (K80/P100/V100)      qwen3:30b         >= 24GB VRAM
#                                                             qwen3:14b         >= 12GB
#                                                             qwen3:8b          >= 8GB
#                                                             qwen3:4b          >= 6GB
#   ollama       no usable GPU                                qwen3:4b          >= 16 cores
#                                                             qwen3:1.7b        otherwise
#
# The CPU tier needs cores, not just RAM: on four vCPUs qwen3:4b generates at 3.0 tok/s,
# which holds a 16GB host on the small tier even though the weights would fit.
GEN_MODEL=qwen3:4b

# SGLang only. Context window and the share of VRAM reserved for weights plus the prefix
# cache. Lower the fraction if the server OOMs on a card that also drives a display.
# SGLANG_CONTEXT_LENGTH=16384
# SGLANG_MEM_FRACTION=0.85

# Only needed if you swap in a gated HuggingFace model. Qwen3 is not gated.
# HF_TOKEN=
