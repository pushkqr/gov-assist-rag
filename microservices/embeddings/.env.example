INFINITY_API_KEY=change-me-to-a-long-random-string

# Reranker tier. deploy.py picks this automatically based on detected hardware unless you set
# it here yourself. The embedding model is NOT configurable here on purpose - see deploy.py.
#   CPU:              BAAI/bge-reranker-base
#   GPU (8GB+ VRAM):  BAAI/bge-reranker-v2-m3
RERANK_MODEL=BAAI/bge-reranker-base
