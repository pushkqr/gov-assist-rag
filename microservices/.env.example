# Copy to microservices/.env and fill in before bringing the stack up.

# Weaviate API key. Any long random string; the application uses the same value.
WEAVIATE_API_KEY=change-me-to-a-long-random-string

# Infinity API key, guarding the embedding and rerank endpoints.
INFINITY_API_KEY=change-me-to-a-long-random-string

# Translation model. The dist-200M variant runs acceptably on CPU; the 1B variant is
# noticeably more accurate on legal and administrative register but wants a GPU.
#   ai4bharat/indictrans2-indic-en-dist-200M   (CPU)
#   ai4bharat/indictrans2-indic-en-1B          (GPU)
INDICTRANS_MODEL=ai4bharat/indictrans2-indic-en-dist-200M


# ---------------------------------------------------------------------------
# Corresponding settings for the application's own .env, once this stack is up.
# ---------------------------------------------------------------------------
# WEAVIATE_URL=http://weaviate
# WEAVIATE_GRPC_PORT=50051
# WEAVIATE_API_KEY=<same as above>
#
# LOCAL_EMBED_URL=http://infinity:7997/embeddings
# LOCAL_EMBED_API_KEY=<same as INFINITY_API_KEY>
# LOCAL_EMBED_MODEL_NAME=BAAI/bge-m3
#
# LOCAL_RERANK_URL=http://infinity:7997/rerank
# LOCAL_RERANK_API_KEY=<same as INFINITY_API_KEY>
# LOCAL_RERANK_MODEL_NAME=BAAI/bge-reranker-base
#
# TRANSLATION_SERVICE_URL=http://translation:8000/translate
#
# GEN_PROVIDER=local
# LOCAL_GEN_URL=http://generation:11434/v1
# LOCAL_GEN_MODEL=qwen3:4b
