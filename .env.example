# ── Mimir Engine · Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ── Google Cloud / Vertex AI ───────────────────────────────────────────────────
# Required for generative answering (Gemini) and ingestion-time translation (GCP)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1         # e.g. us-central1, asia-south1
USE_VERTEX_AI=True                        # Set False to use AI Studio API key instead
# GEMINI_API_KEY=your_ai_studio_key       # Only needed if USE_VERTEX_AI=False

# ── Model Configuration ────────────────────────────────────────────────────────
GEN_MODEL_NAME=gemini-2.5-flash           # Main generative model (Vertex AI)
SPEC_MODEL_NAME=gemini-2.5-flash          # Specialist model (translation fallback etc.)

# ── Embeddings: Self-Hosted BGE-M3 via Infinity ───────────────────────────────
# Deploy: pip install infinity-emb[all] && infinity_emb v2 --model-id BAAI/bge-m3 --port 7997
# All ingestion and query embeddings are routed through this endpoint.
LOCAL_EMBED_URL=http://<YOUR_EMBED_DROPLET_IP>:7997/embeddings
LOCAL_EMBED_API_KEY=                      # Leave empty if your Infinity server is unsecured
LOCAL_EMBED_MODEL_NAME=BAAI/bge-m3
LOCAL_EMBED_TIMEOUT_S=10
USE_AISTUDIO_FOR_EMBEDDINGS=False         # Ignored when LOCAL_EMBED_URL is set
EMBED_MODEL_NAME=BAAI/bge-m3              # Informational — used as model name in API payload

# Optional: Self-hosted BGE reranking via the same Infinity server.
LOCAL_RERANK_URL=http://<YOUR_EMBED_DROPLET_IP>:7997/rerank
LOCAL_RERANK_API_KEY=                     # Leave empty if your Infinity server is unsecured
LOCAL_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
LOCAL_RERANK_TIMEOUT_S=3

# Fast-mode retrieval tuning.
FAST_MODE_CANDIDATE_LIMIT=100
FAST_MODE_RERANK_LIMIT=35
DEEP_MODE_CANDIDATE_LIMIT=150
DEEP_MODE_RERANK_LIMIT=12

# ── Translation Microservice (IndicTrans2) ─────────────────────────────────────
# Required for Marathi/Hindi query detection and translation at retrieval time.
# Ingestion-time translation uses GCP Cloud Translation v3 (via GOOGLE_CLOUD_PROJECT).
TRANSLATION_SERVICE_URL=http://<YOUR_TRANS_DROPLET_IP>:8000/translate
TRANSLATE_LOCATION=global                 # GCP translation location (global or region)

# ── Cerebras (Fast Inference) ──────────────────────────────────────────────────
# Required for the agentic reasoning loop (<2s latency)
CEREBRAS_API_KEY=your_cerebras_api_key

# ── Weaviate (Vector Database) ────────────────────────────────────────────────
# Leave WEAVIATE_URL empty to connect to a local Weaviate instance (docker-compose)
WEAVIATE_URL=http://<YOUR_WEAVIATE_IP>    # e.g. http://206.189.x.x
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=                         # Leave empty if Weaviate auth is disabled

# ── Security & Authentication ──────────────────────────────────────────────────
# Officer portal password. Leave empty to disable auth (not recommended for production).
MIMIR_AUTH_TOKEN=your_secure_officer_password

# Admin token for the token CRUD API (POST/GET/DELETE /api/admin/tokens).
MIMIR_ADMIN_TOKEN=your_secure_admin_token

# Intranet geofencing: comma-separated CIDRs of authorized networks.
# Use 0.0.0.0/0 to allow all traffic (demo/development only).
MIMIR_ALLOWED_SUBNETS=10.0.0.0/8,127.0.0.0/8

# ── Optional: API Throttle Delays ─────────────────────────────────────────────
# Increase if you hit rate limits. Values in seconds. Default is 0 (no delay).
# GEN_API_DELAY=1.0
# EMBED_API_DELAY=0.0
# CEREBRAS_API_DELAY=0.5
