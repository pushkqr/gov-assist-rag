# ── Mimir Environment Configuration ──
# Copy this file to .env and fill in your values.

# Required: Your Google AI API key
GOOGLE_API_KEY=your_api_key_here

# Model Configuration
GEN_MODEL_NAME=gemini-2.5-flash
EMBED_MODEL_NAME=gemini-embedding-001

# Security
# Set this to protect your backend endpoints. Leave empty for public access.
MIMIR_AUTH_TOKEN=

# Optional: API throttle delays (seconds). Default is 0 (no delay).
# Increase if you hit rate limits on free-tier API keys.
# GEN_API_DELAY=2.0
# EMBED_API_DELAY=0.5
