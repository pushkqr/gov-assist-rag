# ── GovAssist Environment Configuration ──
# Copy this file to .env and fill in your values.

# Required: Your Google AI API key
GOOGLE_API_KEY=your_api_key_here

# Model Configuration
GEN_MODEL_NAME=gemma-4-31b-it
EMBED_MODEL_NAME=gemini-embedding-001

# Optional: API throttle delays (seconds). Default is 0 (no delay).
# Increase if you hit rate limits on free-tier API keys.
# GEN_API_DELAY=2.0
# EMBED_API_DELAY=0.5

# Optional: Custom logo path
# GOVASSIST_LOGO_PATH=assets/logo.png
